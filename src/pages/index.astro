---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryLabel, categoryColor } from '../lib/categories.js';
import { fmtTime, isNewPost } from '../lib/date.js';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = allPosts;
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];

const sections = CATEGORIES.map((cat) => ({
  ...cat,
  posts: rest.filter((p) => p.data.category === cat.id).slice(0, 3)
})).filter((s) => s.posts.length > 0);

function fmtDate(d) {
  const dateStr = d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '');
  return `${dateStr} ${fmtTime(d)}`;
}
---
<BaseLayout title="홈" tags={allTags}>
  <style>
    .empty {
      padding: 4rem 1rem;
      text-align: center;
      font-family: 'IBM Plex Mono', monospace;
      color: var(--ink-soft);
      border: 1px dashed var(--rule);
    }

    .featured {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2rem;
      align-items: stretch;
      padding-bottom: 2.75rem;
      margin-bottom: 3.25rem;
      border-bottom: 1px solid var(--rule);
    }
    @media (max-width: 700px) {
      .featured { grid-template-columns: 1fr; }
    }
    .featured .thumb {
      background: var(--bg-raised);
      border: 1px solid var(--rule);
      aspect-ratio: 16 / 10;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s ease;
    }
    .featured .thumb:hover { border-color: var(--gold); }
    .featured .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.9) contrast(1.05);
    }
    .featured .thumb .noimg {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }
    .featured .body {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .eyebrow-tag {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      color: var(--bg);
      background: var(--cat-color, var(--gold));
      padding: 0.22rem 0.55rem;
      margin-bottom: 0.8rem;
      width: fit-content;
    }
    .featured h2 {
      font-family: 'Gowun Batang', serif;
      font-weight: 400;
      font-size: clamp(1.5rem, 3.5vw, 2.15rem);
      line-height: 1.32;
      margin: 0 0 0.7rem;
      color: var(--ink);
    }
    .featured h2 a:hover { color: var(--gold); }
    .featured p.desc {
      color: var(--ink-soft);
      margin: 0 0 0.9rem;
      line-height: 1.65;
    }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }

    .section-block { margin-bottom: 3.25rem; }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 0.6rem;
      margin-bottom: 1.6rem;
    }
    .section-head h2 {
      font-family: 'Gowun Batang', serif;
      font-weight: 400;
      font-size: 1.2rem;
      margin: 0;
      color: var(--ink);
    }
    .section-head h2::before {
      content: '▮ ';
      color: var(--cat-color, var(--gold));
    }
    .section-head a {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }
    .section-head a:hover { color: var(--gold); }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 700px) {
      .grid { grid-template-columns: 1fr; }
    }
    .card {
      display: block;
      padding: 0.6rem;
      border: 1px solid transparent;
      border-left: 3px solid transparent;
      transition: border-color 0.2s ease, transform 0.15s ease;
    }
    .card:hover {
      border-color: var(--gold);
      border-left-color: var(--cat-color, var(--gold));
      transform: translateY(-2px);
    }
    .card .thumb {
      background: var(--bg-raised);
      border: 1px solid var(--rule);
      aspect-ratio: 16 / 10;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.8rem;
    }
    .card .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.9) contrast(1.05);
    }
    .card .thumb .noimg {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      color: var(--ink-soft);
    }
    .card h3 {
      font-family: 'Gowun Batang', serif;
      font-weight: 400;
      font-size: 1.05rem;
      line-height: 1.42;
      margin: 0 0 0.45rem;
      color: var(--ink);
    }
    .card:hover h3 { color: var(--gold); }

    .new-badge {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: #fff;
      background: var(--new-accent);
      padding: 0.12rem 0.45rem;
      border-radius: 999px;
      margin-left: 0.45rem;
      vertical-align: middle;
    }
  </style>

  {allPosts.length === 0 && (
    <div class="empty">아직 게시된 기사가 없습니다. /post 로 첫 기사를 발행해보세요.</div>
  )}

  {featured && (
    <article class="featured">
      <a href={`/blog/${featured.slug}/`} class="thumb">
        {featured.data.image
          ? <img src={featured.data.image} alt={featured.data.title} />
          : <span class="noimg">NO IMAGE</span>}
      </a>
      <div class="body">
        <span class="eyebrow-tag" style={`--cat-color: ${categoryColor(featured.data.category)}`}>{categoryLabel(featured.data.category)}</span>
        <h2>
          <a href={`/blog/${featured.slug}/`}>{featured.data.title}</a>
          {isNewPost(featured.data.pubDate) && <span class="new-badge">NEW</span>}
        </h2>
        <p class="desc">{featured.data.description}</p>
        <div class="meta">{fmtDate(featured.data.pubDate)}</div>
      </div>
    </article>
  )}

  {sections.map((section) => (
    <div class="section-block">
      <div class="section-head">
        <h2 style={`--cat-color: ${section.color}`}>{section.label}</h2>
        <a href={`/category/${section.id}/`}>전체 보기 →</a>
      </div>
      <div class="grid">
        {section.posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="card" style={`--cat-color: ${categoryColor(post.data.category)}`}>
            <div class="thumb">
              {post.data.image
                ? <img src={post.data.image} alt={post.data.title} />
                : <span class="noimg">NO IMAGE</span>}
            </div>
            <h3>{post.data.title}{isNewPost(post.data.pubDate) && <span class="new-badge">NEW</span>}</h3>
            <div class="meta">{fmtDate(post.data.pubDate)}</div>
          </a>
        ))}
      </div>
    </div>
  ))}
</BaseLayout>
