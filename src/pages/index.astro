---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryLabel } from '../lib/categories.js';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = allPosts;
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];

const sections = CATEGORIES.map((cat) => ({
  ...cat,
  posts: rest.filter((p) => p.data.category === cat.id).slice(0, 3)
})).filter((s) => s.posts.length > 0);

function fmtDate(d) {
  return d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '');
}
---
<BaseLayout title="홈" tags={allTags}>
  <style>
    .empty {
      padding: 4rem 1rem;
      text-align: center;
      font-family: 'IBM Plex Mono', monospace;
      color: var(--ink-soft);
      border: 1px dashed var(--rule);
    }

    .featured {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 1.75rem;
      align-items: stretch;
      padding-bottom: 2.5rem;
      margin-bottom: 3rem;
      border-bottom: 1px solid var(--rule);
    }
    @media (max-width: 700px) {
      .featured { grid-template-columns: 1fr; }
    }
    .featured .thumb {
      background: var(--paper-raised);
      border: 1px solid var(--rule);
      aspect-ratio: 16 / 10;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .featured .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .featured .thumb .noimg {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }
    .featured .body {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .eyebrow-tag {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      color: #fff;
      background: var(--signal);
      padding: 0.2rem 0.5rem;
      margin-bottom: 0.7rem;
      width: fit-content;
    }
    .featured h2 {
      font-family: 'Noto Serif KR', serif;
      font-size: clamp(1.5rem, 3.5vw, 2.1rem);
      line-height: 1.3;
      margin: 0 0 0.6rem;
    }
    .featured p.desc {
      color: var(--ink-soft);
      margin: 0 0 0.8rem;
      line-height: 1.6;
    }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }

    .section-block { margin-bottom: 3rem; }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--ink);
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .section-head h2 {
      font-family: 'Noto Serif KR', serif;
      font-size: 1.15rem;
      margin: 0;
    }
    .section-head a {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }
    .section-head a:hover { color: var(--signal); }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 700px) {
      .grid { grid-template-columns: 1fr; }
    }
    .card .thumb {
      background: var(--paper-raised);
      border: 1px solid var(--rule);
      aspect-ratio: 16 / 10;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.75rem;
    }
    .card .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .card .thumb .noimg {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      color: var(--ink-soft);
    }
    .card h3 {
      font-family: 'Noto Serif KR', serif;
      font-size: 1.05rem;
      line-height: 1.4;
      margin: 0 0 0.4rem;
    }
    .card:hover h3 { color: var(--signal); }
  </style>

  {allPosts.length === 0 && (
    <div class="empty">아직 게시된 기사가 없습니다. /post 로 첫 기사를 발행해보세요.</div>
  )}

  {featured && (
    <article class="featured">
      <a href={`/blog/${featured.slug}/`} class="thumb">
        {featured.data.image
          ? <img src={featured.data.image} alt={featured.data.title} />
          : <span class="noimg">NO IMAGE</span>}
      </a>
      <div class="body">
        <span class="eyebrow-tag">{categoryLabel(featured.data.category)}</span>
        <h2><a href={`/blog/${featured.slug}/`}>{featured.data.title}</a></h2>
        <p class="desc">{featured.data.description}</p>
        <div class="meta">{fmtDate(featured.data.pubDate)}</div>
      </div>
    </article>
  )}

  {sections.map((section) => (
    <div class="section-block">
      <div class="section-head">
        <h2>{section.label}</h2>
        <a href={`/category/${section.id}/`}>전체 보기 →</a>
      </div>
      <div class="grid">
        {section.posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="card">
            <div class="thumb">
              {post.data.image
                ? <img src={post.data.image} alt={post.data.title} />
                : <span class="noimg">NO IMAGE</span>}
            </div>
            <h3>{post.data.title}</h3>
            <div class="meta">{fmtDate(post.data.pubDate)}</div>
          </a>
        ))}
      </div>
    </div>
  ))}
</BaseLayout>
