---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryLabel } from '../../lib/categories.js';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.id } }));
}

const { category } = Astro.params;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function fmtDate(d) {
  return d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '');
}
---
<BaseLayout title={categoryLabel(category)}>
  <style>
    .page-head {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 0.6rem;
      margin-bottom: 1.75rem;
    }
    .page-head h1 {
      font-family: 'Noto Serif KR', serif;
      font-size: 1.6rem;
      margin: 0;
    }
    .page-head .count {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      color: var(--ink-soft);
    }
    .empty {
      padding: 4rem 1rem;
      text-align: center;
      font-family: 'IBM Plex Mono', monospace;
      color: var(--ink-soft);
      border: 1px dashed var(--rule);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 700px) {
      .grid { grid-template-columns: 1fr; }
    }
    .card .thumb {
      background: var(--paper-raised);
      border: 1px solid var(--rule);
      aspect-ratio: 16 / 10;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.75rem;
    }
    .card .thumb img { width: 100%; height: 100%; object-fit: cover; }
    .card .thumb .noimg {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      color: var(--ink-soft);
    }
    .card h3 {
      font-family: 'Noto Serif KR', serif;
      font-size: 1.05rem;
      line-height: 1.4;
      margin: 0 0 0.4rem;
    }
    .card:hover h3 { color: var(--signal); }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-soft);
    }
  </style>

  <div class="page-head">
    <h1>{categoryLabel(category)}</h1>
    <div class="count">총 {posts.length}건</div>
  </div>

  {posts.length === 0 && <div class="empty">이 카테고리에는 아직 기사가 없습니다.</div>}

  <div class="grid">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}/`} class="card">
        <div class="thumb">
          {post.data.image
            ? <img src={post.data.image} alt={post.data.title} />
            : <span class="noimg">NO IMAGE</span>}
        </div>
        <h3>{post.data.title}</h3>
        <div class="meta">{fmtDate(post.data.pubDate)}</div>
      </a>
    ))}
  </div>
</BaseLayout>
