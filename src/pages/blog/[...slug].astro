---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categoryLabel, categoryColor } from '../../lib/categories.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d) {
  return d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title={post.data.title} tags={post.data.tags}>
  <style>
    .article-head { margin-bottom: 1.75rem; }
    .category-badge {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      color: var(--bg);
      background: var(--cat-color, var(--gold));
      padding: 0.22rem 0.55rem;
      margin-bottom: 0.8rem;
    }
    .tag-row {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .tag-row span {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.05em;
      color: var(--ink-soft);
      border: 1px solid var(--rule);
      padding: 0.2rem 0.5rem;
    }
    .article-head h1 {
      font-family: 'Gowun Batang', serif;
      font-weight: 400;
      font-size: clamp(1.8rem, 4.5vw, 2.5rem);
      line-height: 1.38;
      margin: 0 0 0.7rem;
      color: var(--ink);
    }
    .article-head .byline {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      color: var(--ink-soft);
    }
    .cover {
      margin: 1.75rem 0;
      border: 1px solid var(--rule);
    }
    .cover img { width: 100%; display: block; filter: saturate(0.9) contrast(1.05); }

    article :global(p) {
      line-height: 1.9;
      font-size: 1.03rem;
      margin: 0 0 1.3rem;
      color: var(--ink);
    }
    article :global(h2), article :global(h3) {
      font-family: 'Gowun Batang', serif;
      font-weight: 400;
      color: var(--ink);
    }
    article :global(img) {
      max-width: 100%;
      border: 1px solid var(--rule);
    }
    article :global(a) {
      color: var(--gold);
      border-bottom: 1px solid var(--gold);
    }
    .back-link {
      display: inline-block;
      margin-top: 3rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      color: var(--ink-soft);
      border-top: 1px solid var(--rule);
      padding-top: 1.1rem;
    }
    .back-link:hover { color: var(--gold); }
  </style>

  <div class="article-head">
    <span class="category-badge" style={`--cat-color: ${categoryColor(post.data.category)}`}>{categoryLabel(post.data.category)}</span>
    <div class="tag-row">
      {post.data.tags.map((t) => <span>{t}</span>)}
    </div>
    <h1>{post.data.title}</h1>
    <div class="byline">{fmtDate(post.data.pubDate)} · 탑건 부동산</div>
  </div>

  {post.data.image && (
    <div class="cover"><img src={post.data.image} alt={post.data.title} /></div>
  )}

  <article>
    <Content />
  </article>

  <a class="back-link" href="/">← 전체 기사 목록</a>
</BaseLayout>
