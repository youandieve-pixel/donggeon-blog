---
import { CATEGORIES } from '../lib/categories.js';

const { title, tags = [] } = Astro.props;
const today = new Date();
const dateStr = today.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long'
});
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | 동건 리포트</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;700;900&family=Pretendard:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #ffffff;
      --bg-raised: #faf8f3;
      --ink: #17181c;
      --ink-soft: #6b6f76;
      --gold: #a9790a;
      --gold-bright: #c9971f;
      --up: #2f7a4f;
      --down: #a13c2e;
      --rule: #e7e4da;
      --dark-strip: #12131a;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Pretendard', -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    .wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 0 1.25rem 5rem;
    }

    /* 마스트헤드 */
    .top-strip {
      background: var(--dark-strip);
      padding: 0.5rem 0;
    }
    .top-strip .wrap {
      padding-bottom: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      color: #9aa0ad;
    }
    .live {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--gold-bright);
    }
    .live .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold-bright);
      animation: pulse 1.8s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(201,151,31,0.5); }
      50% { opacity: 0.4; box-shadow: 0 0 0 4px rgba(201,151,31,0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .live .dot { animation: none; }
    }

    .masthead {
      padding: 2.5rem 0 1.25rem;
      text-align: center;
    }
    .masthead h1 {
      font-family: 'Noto Serif KR', serif;
      font-weight: 900;
      font-size: clamp(2.2rem, 6vw, 3.1rem);
      margin: 0;
      letter-spacing: -0.01em;
      background: linear-gradient(180deg, var(--ink), var(--gold));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .masthead h1:hover { opacity: 0.85; }
    .masthead .dateline {
      margin-top: 0.5rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      color: var(--ink-soft);
    }

    nav.catnav {
      display: flex;
      justify-content: center;
      gap: 2rem;
      padding: 1.1rem 0;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      color: var(--ink-soft);
    }
    nav.catnav a {
      padding-bottom: 0.25rem;
      border-bottom: 2px solid transparent;
    }
    nav.catnav a:hover {
      border-bottom-color: var(--gold);
      color: var(--gold);
    }

    .rule-thick { border: none; border-top: 1px solid var(--rule); margin: 0; }

    /* 티커 */
    .ticker-bar {
      background: var(--dark-strip);
      color: var(--gold-bright);
      overflow: hidden;
      white-space: nowrap;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      letter-spacing: 0.03em;
    }
    .ticker-track {
      display: inline-block;
      padding: 0.6rem 0;
      animation: scroll-left 32s linear infinite;
    }
    .ticker-track span { margin-right: 2.5rem; color: #9aa0ad; }
    .ticker-track span::before { content: '● '; color: var(--gold-bright); font-size: 0.6rem; }
    @keyframes scroll-left {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ticker-track { animation: none; }
    }

    main { padding-top: 2.5rem; }

    footer {
      margin-top: 4rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--rule);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      color: var(--ink-soft);
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="top-strip">
    <div class="wrap">
      <span class="live"><span class="dot"></span>LIVE DISPATCH</span>
      <span>DONGGEON REPORT TERMINAL</span>
    </div>
  </div>

  <div class="wrap">
    <header class="masthead">
      <h1><a href="/">동건 리포트</a></h1>
      <div class="dateline">{dateStr}</div>
    </header>
    <nav class="catnav">
      <a href="/">전체</a>
      {CATEGORIES.map((c) => <a href={`/category/${c.id}/`}>{c.label}</a>)}
    </nav>
  </div>
  <hr class="rule-thick" />

  <div class="ticker-bar">
    <div class="ticker-track">
      {tags.length > 0
        ? [...tags, ...tags].map((t) => <span>{t}</span>)
        : <span>편집 중인 이슈가 곧 업데이트됩니다</span>}
    </div>
  </div>

  <div class="wrap">
    <main>
      <slot />
    </main>
    <footer>동건 리포트 · 개인 아카이브</footer>
  </div>
</body>
</html>
